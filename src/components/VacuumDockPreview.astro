---
const base = import.meta.env.BASE_URL;
---
<article class="project-preview">
  <a class="project-preview-image project-preview-image--cad" href={`${base}work/vacuum-accessory-dock/`} aria-label="View Vacuum Accessory Dock project">
    <img src={`${base}images/vacuum-accessory-dock/final-cad.png`} alt="Final CAD model of the two-socket vacuum accessory dock." loading="lazy" />
  </a>
  <div class="project-preview-copy">
    <p class="eyebrow">Design study / Reverse engineering</p>
    <h3><a href={`${base}work/vacuum-accessory-dock/`}>Vacuum Accessory Dock</a></h3>
    <p class="muted">From a scanned accessory connection to a custom, wall-mountable dock.</p>
    <a class="project-read-link" href={`${base}work/vacuum-accessory-dock/`}>View the design process</a>
  </div>
</article>
