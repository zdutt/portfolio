---
const base = import.meta.env.BASE_URL;
const { href, eyebrow, title, summary, image, alt, surface = 'photo', reversed = false } = Astro.props;
const url = `${base}${href}`;
---
<article class:list={['project-preview', reversed && 'project-preview--reversed']}>
  <a class:list={['project-preview-image', `project-preview-image--${surface}`]} href={url} aria-label={`View ${title} project`}>
    <img src={`${base}${image}`} alt={alt} loading="lazy" />
  </a>
  <div class="project-preview-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h3><a href={url}>{title}</a></h3>
    <p class="muted">{summary}</p>
    <a class="project-read-link" href={url}>View the design process</a>
  </div>
</article>
