---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import DesignNotes from '../components/DesignNotes.astro';
---
<BaseLayout title="Work">
  <header class="page-intro page-intro--split"><h1>Work</h1><p class="intro muted">Projects and design studies, personal and professional.</p></header>
  <section class="section" aria-labelledby="selected-heading">
    <h2 id="selected-heading">Selected Work</h2>
    <ProjectPreview
      href="work/m290-coolant-seal/"
      eyebrow="Repair / Machine recommissioning"
      title="M290 Coolant Seal Repair"
      summary="Corroded sealing faces on a used machine, rebuilt flat in-house against a months-long lead time."
      image="images/m290-coolant/sanded.jpg"
      alt="A coolant tank seating area stripped back to bare metal, with corroded surface alongside."
      surface="photo"
    />
    <ProjectPreview
      href="work/vacuum-accessory-dock/"
      eyebrow="Design study / Reverse engineering"
      title="Vacuum Accessory Dock"
      summary="From a scanned accessory connection to a custom, wall-mountable dock."
      image="images/vacuum-accessory-dock/final-cad.png"
      alt="Final CAD model of the two-socket vacuum accessory dock."
      surface="cad"
      reversed
    />
    <ProjectPreview
      href="work/m290-latch/"
      eyebrow="Redesign / Metal additive manufacturing"
      title="M290 Latch Redesign"
      summary="A worn latch was failing the machine's pressure and purge tests. Shortening it fixed them."
      image="images/m290-latch/latch-printed.jpg"
      alt="The redesigned latch as printed in 17-4 stainless steel, held in a hand."
      surface="photo"
    />
    <ProjectPreview
      href="work/remote-holder/"
      eyebrow="Design study / Reverse engineering"
      title="Remote Holder"
      summary="Three remotes, three shapes. Scanning the remotes and the table they sit on gave the geometry for one holder."
      image="images/remote-holder/remotes.jpg"
      alt="Three remotes laid out on a gridded cutting mat, photographed from above."
      surface="photo"
      reversed
    />
    <ProjectPreview
      href="work/coolant-stand-fea/"
      eyebrow="Structural analysis / Verification"
      title="Coolant Stand Load Verification"
      summary="A 10,000 lbf load case, and a factor of safety of 0.507 that turned out to describe the model."
      image="images/coolant-stand-fea/stand-cad.jpg"
      alt="Shaded CAD view of the welded steel coolant tank stand."
      surface="cad"
    />
  </section>
  <section class="section" aria-labelledby="studies-heading">
    <h2 id="studies-heading">Smaller Work / Design Notes</h2>
    <p class="muted">One-off parts and small repairs.</p>
    <DesignNotes />
  </section>
</BaseLayout>
