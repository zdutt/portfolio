---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import VacuumDockPreview from '../components/VacuumDockPreview.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Home">
  <section class="hero home-intro" aria-labelledby="intro-heading">
    <figure class="home-intro-portrait">
      <img src={`${base}images/intro-headshot.jpg`} alt="Zachary Dutton outdoors" width="828" height="1208" />
    </figure>
    <div class="home-intro-content">
      <h1 id="intro-heading">Zachary Dutton</h1>
      <p class="home-intro-subhead">Design / Manufacturing / Prototyping</p>
      <p class="home-intro-copy">My experience spans metal additive manufacturing at SIG SAUER, aftermarket repair engineering at Pratt &amp; Whitney, and medical-device development at Pirouette Medical. I work across CAD, fixtures, process documentation, and hands-on production to support hardware from design through manufacturing.</p>
    </div>
  </section>

  <ExperienceTimeline />

  <section class="section" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">Selected Work</h2>
      <a href={`${base}work/`}>View work</a>
    </div>
    <VacuumDockPreview />
  </section>

  <section class="section" aria-labelledby="notes-heading">
    <div class="section-heading"><h2 id="notes-heading">Smaller Work / Design Notes</h2></div>
    <p class="muted">A space for smaller studies, experiments, and observations.</p>
    <div class="placeholder notes-placeholder"><span>Design study / Placeholder</span></div>
  </section>

  <section class="section preview" aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <div><p class="muted">A short introduction and background to come.</p><a href={`${base}about/`}>About Zachary</a></div>
  </section>
</BaseLayout>
