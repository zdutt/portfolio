---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import DesignNotes from '../components/DesignNotes.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Home">
  <section class="hero home-intro" aria-labelledby="intro-heading">
    <figure class="home-intro-portrait">
      <img src={`${base}images/intro-headshot.jpg`} alt="Zachary Dutton outdoors" width="828" height="1208" />
    </figure>
    <div class="home-intro-content">
      <h1 id="intro-heading">Zachary Dutton</h1>
      <p class="home-intro-subhead">Design&nbsp;/ Manufacturing&nbsp;/ Prototyping</p>
      <p class="home-intro-copy">My experience spans metal additive manufacturing at Sig Sauer, aftermarket sustainment engineering at Pratt &amp; Whitney, and medical-device development at Pirouette Medical. I work across CAD, fixtures, process documentation, and hands-on production to support hardware from design through manufacturing.</p>
    </div>
  </section>

  <ExperienceTimeline />

  <section class="section" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">Selected Work</h2>
      <a href={`${base}work/`}>View work</a>
    </div>
    <ProjectPreview
      href="work/m290-coolant-seal/"
      eyebrow="Repair / Machine recommissioning"
      title="M290 Coolant Seal Repair"
      summary="Corroded sealing faces on a used machine, rebuilt flat in-house against a months-long lead time."
      image="images/m290-coolant/sanded.jpg"
      alt="A coolant tank seating area stripped back to bare metal, with corroded surface alongside."
      surface="photo"
    />
    <ProjectPreview
      href="work/vacuum-accessory-dock/"
      eyebrow="Design study / Reverse engineering"
      title="Vacuum Accessory Dock"
      summary="From a scanned accessory connection to a custom, wall-mountable dock."
      image="images/vacuum-accessory-dock/final-cad.png"
      alt="Final CAD model of the two-socket vacuum accessory dock."
      surface="cad"
      reversed
    />
    <ul class="work-more">
      <li>
        <a href={`${base}work/m290-latch/`}>M290 Latch Redesign</a>
        <span class="muted">A worn latch was failing the machine's pressure and purge tests. Shortening it fixed them.</span>
      </li>
      <li>
        <a href={`${base}work/coolant-stand-fea/`}>Coolant Stand Load Verification</a>
        <span class="muted">A 10,000 lbf load case, and a factor of safety of 0.507 that turned out to describe the model.</span>
      </li>
      <li>
        <a href={`${base}work/remote-holder/`}>Remote Holder</a>
        <span class="muted">Remotes of different shapes. Scanning each one and the table they sit on gave the geometry for one holder.</span>
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="notes-heading">
    <div class="section-heading"><h2 id="notes-heading">Smaller Work / Design Notes</h2></div>
    <p class="muted">One-off parts and small repairs.</p>
    <DesignNotes />
  </section>

  <section class="section preview" aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <div><p>I studied engineering at Embry-Riddle and the University of Central Florida, and I'm finishing my bachelor's degree part time. I'm most drawn to aviation and aircraft, and to work that takes a part from a CAD model to something I can hold.</p><a href={`${base}about/`}>About Zachary</a></div>
  </section>
</BaseLayout>
