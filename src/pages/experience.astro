---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience.js';
const base = import.meta.env.BASE_URL;
const roles = [...experience].reverse();
---
<BaseLayout title="Experience">
  <header class="page-intro page-intro--split">
    <h1>Experience</h1>
    <p class="intro muted">Six technical roles from 2022 to 2025, newest first.</p>
  </header>

  <section class="section role-list" aria-labelledby="roles-heading">
    <h2 id="roles-heading" class="sr-only">Roles</h2>
    {roles.map((entry) => (
      <article class="role">
        <div class="role-meta">
          <p class="role-dates">{entry.dates}</p>
          <p class="role-location">{entry.location}</p>
        </div>
        <div class="role-body">
          <h3>{entry.company}</h3>
          <p class="role-title">{entry.role}</p>
          <p class="role-summary">{entry.summary}</p>
          {entry.writeUps.length > 0 && (
            <p class="role-writeups">
              <span class="role-writeups-label">Written up in more detail:</span>
              {entry.writeUps.map((item, i) => (
                <>{i > 0 && ', '}<a href={`${base}${item.path}`}>{item.title}</a></>
              ))}
            </p>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="section" aria-labelledby="training-heading">
    <h2 id="training-heading">Training and Certification</h2>
    <ul class="credentials">
      <li>
        <span class="credential-name">Certified SolidWorks Associate (CSWA)</span>
        <span class="muted">Dassault Syst&egrave;mes certification in part modelling and drawing fundamentals.</span>
      </li>
      <li>
        <span class="credential-name">Geometric Dimensioning and Tolerancing</span>
        <span class="muted">Training per ASME Y14.5-2018 using GeoTol Pro 2020, taken during the Pratt &amp; Whitney co-op.</span>
      </li>
      <li>
        <span class="credential-name">OSHA 10-Hour Safety Course</span>
        <span class="muted">Workplace safety training.</span>
      </li>
    </ul>
  </section>

  <section class="section preview" aria-labelledby="resume-heading">
    <h2 id="resume-heading">Resume</h2>
    <div><a href={`${base}resume/`}>View the resume</a></div>
  </section>
</BaseLayout>
