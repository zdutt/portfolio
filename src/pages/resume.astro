---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const pdf = `${base}zachary-dutton-resume.pdf`;
const images = `${base}images/resume/`;
// The two page images are rendered from the PDF. When the PDF is replaced, regenerate them
// with the commands in PROJECT_BRIEF.md ("About page and resume") so the page matches the file.
// The contact details in the image are live links: these areas sit over them, in percent of the
// page, taken from the PDF's own link annotations with a little padding. Regenerate them too.
const links = [
  { href: 'mailto:zdutton04@gmail.com', label: 'Email zdutton04@gmail.com', left: 28.501, top: 6.357, width: 14.416, height: 2.022 },
  { href: 'https://zdutton.com', label: 'zdutton.com', left: 44.143, top: 6.357, width: 8.264, height: 2.022 },
  { href: 'https://www.linkedin.com/in/zachary-dutton-315b30201', label: 'LinkedIn profile', left: 53.633, top: 6.357, width: 26.479, height: 2.022, external: true },
];
---
<BaseLayout title="Resume">
  <header class="page-intro page-intro--split">
    <h1>Resume</h1>
    <p class="intro muted">View it here, or download the PDF.</p>
  </header>

  <section class="section resume-view" aria-label="Resume">
    <div class="resume-frame">
      <div class="resume-actions">
        <a class="button" href={pdf} download="Zachary-Dutton-Resume.pdf">Download PDF</a>
        <a class="button button--outline" href={pdf} target="_blank" rel="noopener">Open PDF</a>
      </div>
      <div class="resume-sheet">
        <img
          src={`${images}resume-1000.webp`}
          srcset={`${images}resume-1000.webp 1000w, ${images}resume-1700.webp 1700w`}
          sizes="(max-width: 700px) calc(100vw - 2.5rem), 52rem"
          width="1700"
          height="2200"
          alt="Zachary Dutton's one-page resume."
          fetchpriority="high"
        />
        {links.map((link) => (
          <a
            class="resume-hotspot"
            href={link.href}
            aria-label={link.label}
            style={`left: ${link.left}%; top: ${link.top}%; width: ${link.width}%; height: ${link.height}%;`}
            {...(link.external ? { target: '_blank', rel: 'me noopener' } : {})}
          ></a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
